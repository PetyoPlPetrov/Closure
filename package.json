{
  "name": "sphere",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "postinstall": "node ./scripts/create-splash-logo.js",
    "prebuild": "expo prebuild",
    "postprebuild": "node ./scripts/create-splash-logo.js",
    "clean:ios": "node ./scripts/clean-xcode-build.js",
    "clean:ios:storage": "node ./scripts/cleanup-ios-storage.js",
    "clean:disk": "node ./scripts/cleanup-disk-space.js",
    "clean:disk:dry": "node ./scripts/cleanup-disk-space.js --dry-run",
    "clean:android": "rm -rf android/build android/app/build",
    "clean:native": "npm run clean:ios && npm run clean:android",
    "clean:all": "npm run clean:native && npm run clean:ios:storage",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "npm run clean:ios && expo run:ios --clean",
    "web": "expo start --web",
    "lint": "expo lint",
    "download-fake-images": "node ./scripts/download-fake-images.js",
    "bump:version": "node ./scripts/bump-version.js",
    "bump:build": "node ./scripts/bump-build.js",
    "build:android": "eas build --platform android --profile production --local",
    "build:ios": "npm run build:ios:prod",
    "build:ios:dev": "npm run clean:ios && node scripts/bump-build.js && eas build --platform ios --profile preview --local",
    "build:ios:prod": "npm run clean:disk && npm run clean:ios && npm run bump:version && exec eas build --platform ios --profile production --local --clear-cache",
    "ota:update:dev": "eas update --channel preview --platform ios --message",
    "ota:update:prod": "eas update --channel production --platform ios --message",
    "update": "eas update --channel production --platform ios --message",
    "phone": "npx expo run:ios --device '00008140-0014346822E3001C'"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.5.1",
    "@react-native-firebase/ai": "23.5.0",
    "@react-native-firebase/analytics": "23.5.0",
    "@react-native-firebase/app": "23.5.0",
    "@react-native-firebase/app-check": "23.5.0",
    "@react-navigation/bottom-tabs": "7.8.11",
    "@react-navigation/elements": "2.9.1",
    "@react-navigation/native": "7.1.24",
    "@shopify/react-native-skia": "2.4.14",
    "expo": "54.0.27",
    "expo-av": "16.0.8",
    "expo-blur": "15.0.8",
    "expo-build-properties": "1.0.10",
    "expo-constants": "18.0.11",
    "expo-device": "8.0.10",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.20",
    "expo-font": "14.0.10",
    "expo-haptics": "15.0.8",
    "expo-image": "3.0.11",
    "expo-image-picker": "17.0.9",
    "expo-linear-gradient": "15.0.8",
    "expo-linking": "8.0.10",
    "expo-localization": "17.0.8",
    "expo-location": "19.0.8",
    "expo-media-library": "18.2.1",
    "expo-notifications": "0.31.4",
    "expo-router": "6.0.17",
    "expo-sharing": "14.0.8",
    "expo-speech-recognition": "3.0.1",
    "expo-splash-screen": "31.0.12",
    "expo-status-bar": "3.0.9",
    "expo-symbols": "1.0.8",
    "expo-system-ui": "6.0.9",
    "expo-updates": "29.0.16",
    "expo-web-browser": "15.0.10",
    "jszip": "3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-background-actions": "4.0.1",
    "react-native-gesture-handler": "2.28.0",
    "react-native-purchases": "9.6.9",
    "react-native-purchases-ui": "9.6.9",
    "react-native-reanimated": "4.1.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.15.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.7.4",
    "react-native-youtube-iframe": "2.4.1",
    "reanimated-color-picker": "4.2.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "54.0.3",
    "@types/react": "19.1.17",
    "eslint": "9.39.1",
    "eslint-config-expo": "10.0.0",
    "sharp": "0.34.5",
    "typescript": "5.9.3"
  },
  "private": true
}
